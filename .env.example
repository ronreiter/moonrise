# Postgres connection string (local Docker or hosted, e.g. Neon)
DATABASE_URL=postgres://moonrise:moonrise@127.0.0.1:5433/moonrise

# Random signing key for session cookies — generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# Optional: create/promote an admin when running `npm run db:setup`
# ADMIN_NAME=Studio admin
# ADMIN_EMAIL=admin@moonrisetlv.com
# ADMIN_PASSWORD=change-me
